generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  INSPECTOR
  VIEWER
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
  CANCELED
}

enum Shift {
  DAY
  NIGHT
  OTHER
}

enum ChecklistItemType {
  BOOLEAN
  TEXT
  NUMBER
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  PHOTO
  SIGNATURE
}

enum AnswerStatus {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
  NOT_ANSWERED
}

enum EvidenceType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
  SIGNATURE
}

enum OccurrenceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OccurrenceStatus {
  OPEN
  IN_ANALYSIS
  RESOLVED
  DISMISSED
}

enum ActionPlanStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELED
}

model Client {
  id            String   @id @default(uuid()) @db.Char(36)
  legalName     String   @map("legal_name")
  tradeName     String?  @map("trade_name")
  document      String?  @unique
  contractCode  String?  @map("contract_code")
  email         String?
  phone         String?
  active        Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  posts             Post[]
  users             User[]
  checklistTemplates ChecklistTemplate[]

  @@map("clients")
}

model Post {
  id          String   @id @default(uuid()) @db.Char(36)
  clientId    String   @map("client_id") @db.Char(36)
  code        String
  name        String
  description String?
  address     String?
  city        String?
  state       String?  @db.VarChar(2)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  timezone    String   @default("America/Sao_Paulo")
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  collaborators Collaborator[]
  inspections   Inspection[]

  @@unique([clientId, code])
  @@index([clientId, active])
  @@map("posts")
}

model Collaborator {
  id           String   @id @default(uuid()) @db.Char(36)
  postId       String?  @map("post_id") @db.Char(36)
  registration String?  @unique
  name         String
  email        String?  @unique
  phone        String?
  jobTitle     String?  @map("job_title")
  active       Boolean  @default(true)
  hiredAt      DateTime? @map("hired_at") @db.Date
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  post          Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  user          User?
  inspections   Inspection[]  @relation("InspectorCollaborator")
  actionPlans   ActionPlan[]  @relation("ActionPlanAssignee")

  @@index([postId, active])
  @@map("collaborators")
}

model User {
  id                String   @id @default(uuid()) @db.Char(36)
  passwordHash      String?  @map("password_hash") @db.VarChar(255)
  clientId          String?  @map("client_id") @db.Char(36)
  collaboratorId    String?  @unique @map("collaborator_id") @db.Char(36)
  email             String   @unique
  name              String
  role              UserRole @default(VIEWER)
  permissions       Json?
  isDeveloper       Boolean  @default(false) @map("is_developer")
  active            Boolean  @default(true)
  lastLoginAt       DateTime? @map("last_login_at") @db.DateTime(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  client             Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  collaborator       Collaborator?  @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  createdInspections Inspection[]   @relation("InspectionCreator")
  approvedInspections Inspection[]  @relation("InspectionApprover")
  reportedOccurrences Occurrence[]  @relation("OccurrenceReporter")
  auditLogs          AuditLog[]     @relation("AuditActor")

  @@index([clientId, active])
  @@map("users")
}

model OperationalState {
  id        String   @id @default("main")
  data      Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("operational_state")
}

model ChecklistTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  clientId    String?  @map("client_id") @db.Char(36)
  name        String
  description String?
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  client      Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
  inspections Inspection[]

  @@unique([clientId, name, version])
  @@map("checklist_templates")
}

model ChecklistItem {
  id           String            @id @default(uuid()) @db.Char(36)
  checklistId  String            @map("checklist_id") @db.Char(36)
  parentId     String?           @map("parent_id") @db.Char(36)
  code         String
  title        String
  description  String?
  type         ChecklistItemType @default(BOOLEAN)
  required     Boolean           @default(true)
  position     Int
  options      Json?
  weight       Decimal?          @db.Decimal(8, 2)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.DateTime(6)

  checklist ChecklistTemplate @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  parent    ChecklistItem?     @relation("ChecklistHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  ChecklistItem[]    @relation("ChecklistHierarchy")
  responses InspectionResponse[]

  @@unique([checklistId, code])
  @@unique([checklistId, position])
  @@index([parentId])
  @@map("checklist_items")
}

model Inspection {
  id                     String           @id @default(uuid()) @db.Char(36)
  postId                 String           @map("post_id") @db.Char(36)
  checklistId            String           @map("checklist_id") @db.Char(36)
  createdById            String           @map("created_by_id") @db.Char(36)
  inspectorCollaboratorId String?          @map("inspector_collaborator_id") @db.Char(36)
  approvedById           String?          @map("approved_by_id") @db.Char(36)
  reference              String           @unique
  status                 InspectionStatus @default(DRAFT)
  shift                  Shift            @default(OTHER)
  scheduledAt            DateTime?        @map("scheduled_at") @db.DateTime(6)
  startedAt              DateTime?        @map("started_at") @db.DateTime(6)
  completedAt            DateTime?        @map("completed_at") @db.DateTime(6)
  approvedAt             DateTime?        @map("approved_at") @db.DateTime(6)
  score                  Decimal?         @db.Decimal(8, 2)
  notes                  String?
  metadata               Json?
  createdAt              DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.DateTime(6)

  post          Post                  @relation(fields: [postId], references: [id], onDelete: Restrict)
  checklist     ChecklistTemplate     @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("InspectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  inspector     Collaborator?         @relation("InspectorCollaborator", fields: [inspectorCollaboratorId], references: [id], onDelete: SetNull)
  approvedBy    User?                 @relation("InspectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  responses     InspectionResponse[]
  evidences     Evidence[]
  occurrences   Occurrence[]

  @@index([postId, status, scheduledAt])
  @@index([createdById, createdAt])
  @@map("inspections")
}

model InspectionResponse {
  id              String       @id @default(uuid()) @db.Char(36)
  inspectionId    String       @map("inspection_id") @db.Char(36)
  checklistItemId String       @map("checklist_item_id") @db.Char(36)
  status          AnswerStatus @default(NOT_ANSWERED)
  valueText       String?      @map("value_text")
  valueNumber     Decimal?     @map("value_number") @db.Decimal(18, 4)
  valueBoolean    Boolean?     @map("value_boolean")
  valueJson       Json?        @map("value_json")
  comment         String?
  answeredAt      DateTime?    @map("answered_at") @db.DateTime(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(6)

  inspection   Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  evidences    Evidence[]

  @@unique([inspectionId, checklistItemId])
  @@index([status])
  @@map("inspection_responses")
}

model Evidence {
  id           String       @id @default(uuid()) @db.Char(36)
  inspectionId String       @map("inspection_id") @db.Char(36)
  responseId   String?      @map("response_id") @db.Char(36)
  occurrenceId String?      @map("occurrence_id") @db.Char(36)
  type         EvidenceType @default(PHOTO)
  bucket       String       @default("evidencias")
  storagePath  String       @map("storage_path")
  fileName     String       @map("file_name")
  mimeType     String       @map("mime_type")
  sizeBytes    BigInt?      @map("size_bytes")
  checksum     String?
  caption      String?
  capturedAt   DateTime?    @map("captured_at") @db.DateTime(6)
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(6)

  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  response   InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  occurrence Occurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@unique([bucket, storagePath])
  @@index([inspectionId, createdAt])
  @@index([occurrenceId])
  @@map("evidences")
}

model Occurrence {
  id           String             @id @default(uuid()) @db.Char(36)
  inspectionId String             @map("inspection_id") @db.Char(36)
  reportedById String             @map("reported_by_id") @db.Char(36)
  code         String             @unique
  title        String
  description  String
  severity     OccurrenceSeverity @default(MEDIUM)
  status       OccurrenceStatus   @default(OPEN)
  detectedAt   DateTime           @default(now()) @map("detected_at") @db.DateTime(6)
  resolvedAt   DateTime?          @map("resolved_at") @db.DateTime(6)
  resolution   String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.DateTime(6)

  inspection Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  reportedBy User         @relation("OccurrenceReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  evidences  Evidence[]
  actionPlans ActionPlan[]

  @@index([inspectionId, status, severity])
  @@map("occurrences")
}

model ActionPlan {
  id                   String           @id @default(uuid()) @db.Char(36)
  occurrenceId         String           @map("occurrence_id") @db.Char(36)
  assignedToId         String?          @map("assigned_to_id") @db.Char(36)
  title                String
  description          String
  status               ActionPlanStatus @default(OPEN)
  priority             Int              @default(3)
  dueAt                DateTime?        @map("due_at") @db.DateTime(6)
  startedAt            DateTime?        @map("started_at") @db.DateTime(6)
  completedAt          DateTime?        @map("completed_at") @db.DateTime(6)
  completionNotes      String?          @map("completion_notes")
  createdAt            DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.DateTime(6)

  occurrence Occurrence    @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  assignedTo Collaborator? @relation("ActionPlanAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([occurrenceId, status])
  @@index([assignedToId, dueAt])
  @@map("action_plans")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
