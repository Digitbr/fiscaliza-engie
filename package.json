{
  "name": "fiscalizapro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de fiscalização operacional com Next.js, Supabase PostgreSQL e Prisma.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:legacy": "node --check index.js && node --check app.js && node --check public/app.js",
    "check": "npm run check:legacy && npm run prisma:validate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "operator:create": "tsx prisma/create-operator.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^17.0.0",
    "jszip": "^3.10.1",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
